# ox-mcp env configuration. Every section field: OX_MCP_[ID_]<SECTION>_<FIELD>
# SECTION ∈ MAIL | CALDAV | CARDDAV. Default account = non-indexed form.
# A section configured only here (no config.json) works fine; a section
# configured nowhere means its tools are disabled.

# --- mail section ---
# Default transport is ox-api (Open-Xchange HTTP API): server = webmail host.
OX_MCP_MAIL_SERVER=webmail.example.com
OX_MCP_MAIL_USER=you@yourdomain.com
OX_MCP_MAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# For direct IMAP/SMTP against generic mail hosts set transport to imap:
# OX_MCP_MAIL_TRANSPORT=imap
# OX_MCP_MAIL_SERVER=mail.example.com
# Optional split endpoints (e.g. Gmail); TLS mode derives from port (993/465 TLS, 143/587 STARTTLS):
# OX_MCP_MAIL_IMAP_HOST=imap.example.com
# OX_MCP_MAIL_IMAP_PORT=993
# OX_MCP_MAIL_SMTP_HOST=smtp.example.com
# OX_MCP_MAIL_SMTP_PORT=587
# Force TLS mode explicitly when using a non-standard port (overrides the port heuristic):
# OX_MCP_MAIL_IMAP_SECURE=true   # true = implicit TLS, false = STARTTLS
# OX_MCP_MAIL_SMTP_SECURE=false

# --- calDav section (calendar; may need its own CalDAV-scoped app password) ---
OX_MCP_CALDAV_SERVER=dav.example.com
OX_MCP_CALDAV_USER=you@yourdomain.com
OX_MCP_CALDAV_APP_PASSWORD=yyyy-yyyy-yyyy-yyyy

# --- cardDav section (contacts; may need its own CardDAV-scoped app password) ---
# OX_MCP_CARDDAV_SERVER=dav.example.com
# OX_MCP_CARDDAV_USER=you@yourdomain.com
# OX_MCP_CARDDAV_APP_PASSWORD=zzzz-zzzz-zzzz-zzzz

# --- Explicit config file (must exist; not auto-created) ---
# OX_MCP_CONFIG=/path/to/config.json

# --- Section master switches ---
# OX_MCP_ENABLE_MAIL=false
# OX_MCP_ENABLE_CALDAV=false
# OX_MCP_ENABLE_CARDDAV=false

# --- Enable write tools (all disabled by default) ---
# OX_MCP_ENABLE_EMAIL_SEND=true
# OX_MCP_ENABLE_EMAIL_SAVE_DRAFT=true
# OX_MCP_ENABLE_EMAIL_REPLY=true
# OX_MCP_ENABLE_EMAIL_REPLY_ALL=true
# OX_MCP_ENABLE_EMAIL_DELETE=true
# OX_MCP_ENABLE_EMAIL_MOVE=true
# OX_MCP_ENABLE_EMAIL_FLAG=true
# OX_MCP_ENABLE_EMAIL_MARK_READ=true
# OX_MCP_ENABLE_EMAIL_MARK_UNREAD=true
# OX_MCP_ENABLE_EMAIL_MARK_SPAM=true
# OX_MCP_ENABLE_EMAIL_ARCHIVE=true
# OX_MCP_ENABLE_EMAIL_CREATE_FOLDER=true
# OX_MCP_ENABLE_EMAIL_DELETE_FOLDER=true
# OX_MCP_ENABLE_EMAIL_FILTER_CREATE=true
# OX_MCP_ENABLE_EMAIL_FILTER_UPDATE=true
# OX_MCP_ENABLE_CALENDAR_CREATE_EVENT=true
# OX_MCP_ENABLE_CALENDAR_UPDATE_EVENT=true
# OX_MCP_ENABLE_CALENDAR_DELETE_EVENT=true
# OX_MCP_ENABLE_CALENDAR_RESPOND_EVENT=true   # accept/decline/tentative (one flag, three tools)
# OX_MCP_ENABLE_CONTACT_CREATE=true

# --- Multi-account (indexed) ---
# OX_MCP_ACCOUNTS=work,personal
# OX_MCP_DEFAULT_SERVER=work
# OX_MCP_WORK_MAIL_SERVER=mail.work.com
# OX_MCP_WORK_MAIL_USER=me@work.com
# OX_MCP_WORK_MAIL_APP_PASSWORD=...
# OX_MCP_PERSONAL_CALDAV_SERVER=dav.personal.com
# OX_MCP_PERSONAL_CALDAV_USER=me@personal.com
# OX_MCP_PERSONAL_CALDAV_APP_PASSWORD=...

# --- OAuth / OIDC example (per section) ---
# OX_MCP_WORK_MAIL_AUTH_TYPE=oauth2-refresh
# OX_MCP_WORK_MAIL_CLIENT_ID=...
# OX_MCP_WORK_MAIL_CLIENT_SECRET=...
# OX_MCP_WORK_MAIL_REFRESH_TOKEN=...
# OX_MCP_WORK_MAIL_TOKEN_URL=https://idp.example.com/oauth/token

# --- Network ---
# Request timeout in seconds for all HTTP/IMAP/SMTP operations (default 300).
# OX_MCP_TIMEOUT_SECONDS=300

# --- Logging ---
# OX_MCP_LOG_LEVEL=info   # debug | info | warn | error | silent
